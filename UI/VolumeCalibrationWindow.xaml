<Window x:Class="AudioSwitcher.UI.VolumeCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Volume Calibration Lab - Perceptual Loudness Matching"
        Height="680" Width="840"
        MinHeight="600" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="#121216" Foreground="#F4F4F5"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Main 2-column workspace -->
            <RowDefinition Height="*" />
            <!-- Footer action bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1A1A22" CornerRadius="10" Padding="16,14" Margin="0,0,0,16" BorderBrush="#2D2D38" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔊 Volume Calibration Lab" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                        <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Perceptual Matching" FontSize="10.5" FontWeight="SemiBold" Foreground="#93C5FD" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Calibrate volume curves between different headphones, DACs, and speakers so audio stays balanced when switching." FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0" />
                </StackPanel>
                <CheckBox x:Name="ChkEnableVolumeMapping" Grid.Column="1" Content="Enable Volume Auto-Mapping on Switch" IsChecked="True" Foreground="#93C5FD" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Cursor="Hand" Checked="ChkEnableVolumeMapping_Changed" Unchecked="ChkEnableVolumeMapping_Changed" />
            </Grid>
        </Border>

        <!-- Main Workspace (Left: Interactive Tester & Sliders, Right: Curve Graph & Points) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Calibration controls -->
                <ColumnDefinition Width="1.15*" />
                <!-- Curve visualizer & points -->
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Device Selection & Interactive Audio Tester -->
            <Border Grid.Column="0" Background="#1A1A22" CornerRadius="10" Padding="16" Margin="0,0,12,0" BorderBrush="#2D2D38" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Step 1: Device Selection -->
                        <TextBlock Text="1. Select Reference &amp; Target Devices" FontSize="14" FontWeight="SemiBold" Foreground="#60A5FA" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Reference Device (Baseline):" FontSize="11.5" Foreground="#A1A1AA" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbReferenceDevice" Grid.Row="1" Grid.Column="0" Height="32" Margin="0,0,8,0" Style="{DynamicResource DarkComboBoxStyle}" SelectionChanged="CmbReferenceDevice_SelectionChanged" />

                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Target Device (To Calibrate):" FontSize="11.5" Foreground="#A1A1AA" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbTargetDevice" Grid.Row="1" Grid.Column="1" Height="32" Style="{DynamicResource DarkComboBoxStyle}" SelectionChanged="CmbTargetDevice_SelectionChanged" />
                        </Grid>

                        <!-- Step 2: Calibration Level Selection (25%, 50%, 75%) -->
                        <TextBlock Text="2. Select Calibration Test Level" FontSize="14" FontWeight="SemiBold" Foreground="#60A5FA" Margin="0,10,0,8" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="RbLevelLow" Grid.Column="0" Content="Low (25%)" GroupName="CalLevel" Margin="0,0,4,0" IsChecked="False" Checked="RbLevel_Checked" Foreground="#E4E4E7" FontSize="12" Cursor="Hand" />
                            <RadioButton x:Name="RbLevelMid" Grid.Column="1" Content="Mid (50%)" GroupName="CalLevel" Margin="0,0,4,0" IsChecked="True" Checked="RbLevel_Checked" Foreground="#E4E4E7" FontSize="12" Cursor="Hand" />
                            <RadioButton x:Name="RbLevelHigh" Grid.Column="2" Content="High (75%)" GroupName="CalLevel" IsChecked="False" Checked="RbLevel_Checked" Foreground="#E4E4E7" FontSize="12" Cursor="Hand" />
                        </Grid>

                        <!-- Test Signal Picker -->
                        <Border Background="#22222A" CornerRadius="8" Padding="12,10" Margin="0,0,0,14" BorderBrush="#33333E" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Test Sound:" FontSize="12" FontWeight="SemiBold" Foreground="#D4D4D8" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox x:Name="CmbSignalType" Grid.Column="1" Height="28" Style="{DynamicResource DarkComboBoxStyle}" SelectionChanged="CmbSignalType_SelectionChanged">
                                    <ComboBoxItem Content="Pink Noise (Recommended for Loudness)" IsSelected="True" Tag="0" />
                                    <ComboBoxItem Content="Warm Harmonic Chord" Tag="1" />
                                    <ComboBoxItem Content="Pulsed Melody Chime" Tag="2" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Step 3: Interactive Playback & A-B Switch -->
                        <TextBlock Text="3. Audio Playback &amp; A-B Comparison" FontSize="14" FontWeight="SemiBold" Foreground="#60A5FA" Margin="0,0,0,8" />

                        <!-- Active status badge banner -->
                        <Border x:Name="BdrActivePlayingBadge" Background="#1E293B" CornerRadius="6" Padding="10,6" Margin="0,0,0,10" BorderBrush="#3B82F6" BorderThickness="1">
                            <TextBlock x:Name="TxtActivePlayingBadge" Text="⏹ Audio Stopped. Click below to test." FontSize="12" FontWeight="SemiBold" Foreground="#93C5FD" HorizontalAlignment="Center" />
                        </Border>

                        <UniformGrid Columns="2" Margin="0,0,0,14">
                            <Button x:Name="BtnPlayReference" Content="▶ Play Reference" Style="{DynamicResource SmallBtnStyle}" Height="34" Margin="0,0,4,6" Click="BtnPlayReference_Click" ToolTip="Play test sound on Reference device" />
                            <Button x:Name="BtnPlayTarget" Content="▶ Play Target" Style="{DynamicResource SmallBtnStyle}" Height="34" Margin="4,0,0,6" Click="BtnPlayTarget_Click" ToolTip="Play test sound on Target device" />
                            <Button x:Name="BtnAutoABToggle" Content="⇄ Auto A-B Switch" Style="{DynamicResource PrimaryBtnStyle}" Background="#2563EB" Height="34" Margin="0,0,4,0" Click="BtnAutoABToggle_Click" ToolTip="Automatically alternate between Reference and Target every 2s for side-by-side matching" />
                            <Button x:Name="BtnStopAudio" Content="⏹ Stop Audio" Style="{DynamicResource DangerIconBtnStyle}" Width="Auto" Height="34" Margin="4,0,0,0" Click="BtnStopAudio_Click" ToolTip="Stop all test audio playback" />
                        </UniformGrid>

                        <!-- Target Device Volume Slider -->
                        <Border Background="#24242E" CornerRadius="8" Padding="14,12" BorderBrush="#363644" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Target Device Calibrated Volume:" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtTargetVolumePercent" Grid.Column="1" Text="50%" FontSize="14" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center" />
                                </Grid>

                                <Slider x:Name="SliderTargetVolume" Minimum="0" Maximum="100" Value="50" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderTargetVolume_ValueChanged" Margin="0,4,0,10" Cursor="Hand" />

                                <Button x:Name="BtnStorePoint" Content="✓ Store Calibration Point for this Level" Style="{DynamicResource PrimaryBtnStyle}" Height="32" Click="BtnStorePoint_Click" ToolTip="Save this matched volume point into the device calibration profile" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Panel: Curve Graph & Profile Summary -->
            <Border Grid.Column="1" Background="#1A1A22" CornerRadius="10" Padding="16" BorderBrush="#2D2D38" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="200" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Volume Calibration Curve" FontSize="14" FontWeight="SemiBold" Foreground="#60A5FA" Margin="0,0,0,8" />

                    <!-- Live Curve Canvas Graph -->
                    <Border Grid.Row="1" Background="#141419" CornerRadius="8" BorderBrush="#282832" BorderThickness="1" ClipToBounds="True">
                        <Canvas x:Name="CanvasCurveGraph" SizeChanged="CanvasCurveGraph_SizeChanged" />
                    </Border>

                    <!-- Calibration Points Table / List -->
                    <Border Grid.Row="2" Background="#202028" CornerRadius="8" Padding="10" Margin="0,10,0,10" BorderBrush="#32323E" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Calibrated Profile Points:" FontSize="12" FontWeight="SemiBold" Foreground="#D4D4D8" Margin="0,0,0,6" />
                                <TextBlock x:Name="TxtPointLow" Text="• Low (25% Ref) ➔ Target: 25%" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2" />
                                <TextBlock x:Name="TxtPointMid" Text="• Mid (50% Ref) ➔ Target: 50%" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2" />
                                <TextBlock x:Name="TxtPointHigh" Text="• High (75% Ref) ➔ Target: 75%" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2" />
                                <TextBlock Text="• Minimum (0% Ref) ➔ Target: 0%" FontSize="11" Foreground="#71717A" Margin="0,2" />
                                <TextBlock Text="• Maximum (100% Ref) ➔ Target: 100%" FontSize="11" Foreground="#71717A" Margin="0,2" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Quick Preset Buttons -->
                    <UniformGrid Grid.Row="3" Columns="2">
                        <Button x:Name="BtnQuickProportional" Content="⚡ 1-Point Scale" Style="{DynamicResource SmallBtnStyle}" Height="30" Margin="0,0,4,0" Click="BtnQuickProportional_Click" ToolTip="Calculate smooth curve scaled from the 50% Mid Point" />
                        <Button x:Name="BtnResetLinear" Content="↺ Reset to 1:1" Style="{DynamicResource SmallBtnStyle}" Height="30" Margin="4,0,0,0" Click="BtnResetLinear_Click" ToolTip="Reset curve to standard 1:1 linear mapping" />
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Action Bar -->
        <Border Grid.Row="2" Background="#1A1A22" CornerRadius="10" Padding="14,10" Margin="0,14,0,0" BorderBrush="#2D2D38" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatusMessage" Text="Adjust the Target slider until both devices sound identical in loudness." FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Close" Style="{DynamicResource SmallBtnStyle}" Width="80" Height="32" Margin="0,0,8,0" Click="BtnClose_Click" />
                    <Button Content="💾 Save Profile" Style="{DynamicResource PrimaryBtnStyle}" Width="120" Height="32" Click="BtnSaveProfile_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
