<UserControl x:Class="AudioSwitcher.UI.PriorityListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AudioSwitcher.UI"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="680">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisInverted" Invert="True" />
        <local:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis" />
        <local:ConnectionStatusBrushConverter x:Key="ConnBrush" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Category Header, Auto-Switch Toggle & Filter Box -->
        <Border Grid.Row="0" Background="#242429" CornerRadius="10" Padding="16,14" Margin="0,0,0,12" BorderBrush="#323238" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TxtCategoryTitle" Text="Output - Sound" FontSize="18" FontWeight="SemiBold" Foreground="#F4F4F5" />
                        <TextBlock x:Name="TxtCategoryDescription" Text="Prioritized devices for system sounds, games, and media playback." FontSize="12" Foreground="#A1A1AA" Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnOpenCalibrationLabHeader" Content="🔊 Calibrate Volumes" Style="{DynamicResource SmallBtnStyle}" Margin="0,0,12,0" Padding="10,5" Click="BtnOpenCalibrationLab_Click" ToolTip="Open the interactive Volume Calibration Lab to balance loudness across devices" />
                        <CheckBox x:Name="ChkMatchSound" Content="🔗 Match Sound" VerticalAlignment="Center" Foreground="#93C5FD" FontSize="12" FontWeight="SemiBold" Margin="0,0,16,0" Checked="ChkMatchSound_Changed" Unchecked="ChkMatchSound_Changed" Cursor="Hand" Visibility="Collapsed" ToolTip="Automatically use the same device and priority list as Sound" />
                        <TextBlock Text="Auto-Switch" VerticalAlignment="Center" Foreground="#D4D4D8" FontSize="13" Margin="0,0,10,0" />
                        <CheckBox x:Name="ChkAutoSwitch" IsChecked="True" VerticalAlignment="Center" Checked="ChkAutoSwitch_Changed" Unchecked="ChkAutoSwitch_Changed" Cursor="Hand" />
                    </StackPanel>
                </Grid>

                <!-- Mirrored Banner -->
                <Border x:Name="BannerMirrored" Grid.Row="1" Background="#1E293B" CornerRadius="6" BorderBrush="#3B82F6" BorderThickness="1" Padding="10,6" Margin="0,10,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔗" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="TxtBannerMirrored" Text="Mirrored with Sound — This communications category is automatically using the same device and priorities as Sound." FontSize="12" Foreground="#93C5FD" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Temporary Override Banner -->
                <Border x:Name="BannerTempOverride" Grid.Row="2" Background="#2A1C0E" CornerRadius="6" BorderBrush="#F59E0B" BorderThickness="1.5" Padding="12,8" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Temporary Device Override Active" FontSize="13" FontWeight="Bold" Foreground="#FBBF24" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="TxtTempOverrideDetails" Text="Using temporary device. Priority auto-switching is paused." FontSize="11" Foreground="#FDE68A" Margin="18,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnMakeTempPermanent" Content="⭐ Make #1 Priority" Style="{DynamicResource SmallBtnStyle}" Margin="0,0,8,0" Click="BtnMakeTempPermanent_Click" ToolTip="Promote this device to permanent #1 priority and clear override" />
                            <Button x:Name="BtnClearTempOverride" Content="↺ Resume Auto-Priority" Style="{DynamicResource PrimaryBtnStyle}" Background="#D97706" Click="BtnClearTempOverride_Click" ToolTip="Revert to normal priority order immediately" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Search / Filter Input Bar -->
                <Border x:Name="BdrSearchFilter" Grid.Row="3" Background="#1B1B22" CornerRadius="6" BorderBrush="#33333F" BorderThickness="1" Padding="8,4" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="11" Foreground="#71717A" VerticalAlignment="Center" Margin="2,0,6,0" />
                        <TextBox x:Name="TxtSearchFilter" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="#F4F4F5" FontSize="12" VerticalAlignment="Center" CaretBrush="#60A5FA" TextChanged="TxtSearchFilter_TextChanged" />
                        <TextBlock Text="Filter priority devices..." Grid.Column="1" FontSize="12" Foreground="#52525B" VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearchFilter}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button x:Name="BtnClearFilter" Grid.Column="2" Content="✕" Width="18" Height="18" FontSize="9" Click="BtnClearFilter_Click" ToolTip="Clear Filter">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DangerIconBtnStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearchFilter}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Priority List Container -->
        <Border Grid.Row="1" Background="#1E1E24" CornerRadius="10" BorderBrush="#2D2D35" BorderThickness="1" Padding="12">
            <Grid>
                <!-- Empty state when no items in priority list -->
                <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="20">
                    <TextBlock x:Name="TxtEmptyTitle" Text="No prioritized devices set" FontSize="15" FontWeight="SemiBold" Foreground="#71717A" HorizontalAlignment="Center" />
                    <TextBlock x:Name="TxtEmptySubtitle" Text="Select a device below and click 'Add to Priority List'" FontSize="12" Foreground="#52525B" Margin="0,4,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ItemsPriorityList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:PriorityItemViewModel}">
                                <Border x:Name="CardBorder"
                                        Background="{Binding CardBackground}"
                                        BorderBrush="{Binding CardBorderBrush}"
                                        BorderThickness="{Binding CardBorderThickness}"
                                        Opacity="{Binding CardOpacity}"
                                        CornerRadius="8"
                                        Margin="0,0,0,8"
                                        Padding="10,8"
                                        AllowDrop="True"
                                        Tag="{Binding}"
                                        DragOver="ItemCard_DragOver"
                                        DragLeave="ItemCard_DragLeave"
                                        Drop="ItemCard_Drop">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Top Drop Insertion Guide Line -->
                                        <Border x:Name="TopDropGuide" Grid.Row="0" Height="3" Background="#3B82F6" CornerRadius="1.5" Margin="0,0,0,4" Visibility="Collapsed" />

                                        <!-- Main Card Content -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <!-- Indicator Stripe, Drag Handle & Rank Badge -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- Device Info, Badges & Volume Slider -->
                                                <ColumnDefinition Width="*" />
                                                <!-- Action Buttons -->
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Left Drag Handle Zone (Click & drag only from here) -->
                                            <Border x:Name="DragGripHandle"
                                                    Grid.Column="0"
                                                    CornerRadius="6"
                                                    Padding="5,4,8,4"
                                                    Margin="0,0,12,0"
                                                    Cursor="SizeNS"
                                                    ToolTip="⠿ Click &amp; drag here to reorder device priority"
                                                    Tag="{Binding}"
                                                    PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                                    PreviewMouseMove="DragHandle_PreviewMouseMove"
                                                    PreviewMouseLeftButtonUp="DragHandle_PreviewMouseLeftButtonUp">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#17171F" />
                                                        <Setter Property="BorderBrush" Value="#323242" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#252536" />
                                                                <Setter Property="BorderBrush" Value="#60A5FA" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Left Color Indicator Bar -->
                                                    <Border Width="3.5" Height="24" CornerRadius="1.5" Background="{Binding IndicatorStripeBrush}" Margin="0,0,6,0" />

                                                    <!-- Drag Grip Dots Icon -->
                                                    <TextBlock Text="⠿" FontSize="14" Foreground="#8E8EA0" VerticalAlignment="Center" Margin="0,0,6,0" />

                                                    <!-- Rank Badge -->
                                                    <Border CornerRadius="4" Background="#101015" Padding="6,2" VerticalAlignment="Center" MinWidth="36">
                                                        <TextBlock Text="{Binding RankBadgeText}" FontWeight="Bold" FontSize="11" Foreground="#60A5FA" HorizontalAlignment="Center" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <!-- Middle Group: Device Title, Badges, Status & Volume -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Device Name -->
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" Foreground="#F4F4F5" TextTrimming="CharacterEllipsis" MaxWidth="280" VerticalAlignment="Center" />

                                                    <!-- Regular Default badge -->
                                                    <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Currently active default device for this category">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsCurrentDefault}" Value="True" />
                                                                            <Condition Binding="{Binding IsTemporaryOverride}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="⭐ ACTIVE DEFAULT" FontSize="9.5" FontWeight="Bold" Foreground="#93C5FD" />
                                                    </Border>

                                                    <!-- Temporary Override Badge -->
                                                    <Border Background="#78350F" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Temporary override active. Auto-switch is paused.">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsCurrentDefault}" Value="True" />
                                                                            <Condition Binding="{Binding IsTemporaryOverride}" Value="True" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="⚡ TEMP ACTIVE" FontSize="9.5" FontWeight="Bold" Foreground="#FDE68A" />
                                                    </Border>

                                                    <!-- Cross-Category Badge (e.g. Comms Default) -->
                                                    <Border Background="#312E81" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding OtherCategoryBadge, Converter={StaticResource StringNotEmptyToVis}}" ToolTip="Device is also assigned as default for another category">
                                                        <TextBlock Text="{Binding OtherCategoryBadge}" FontSize="9.5" FontWeight="SemiBold" Foreground="#C7D2FE" />
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Status line and Volume Controls -->
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                                    <!-- Status dot & text -->
                                                    <Ellipse Width="7" Height="7" Fill="{Binding StatusDotBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{Binding StatusDotForeground}" VerticalAlignment="Center" Margin="0,0,12,0" />

                                                    <!-- Per-Device Volume Control Bar -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasVolumeControl, Converter={StaticResource BoolToVis}}">
                                                        <!-- Mute Button -->
                                                        <Button Content="{Binding MuteIcon}"
                                                                Width="22" Height="20" FontSize="10"
                                                                Style="{DynamicResource IconBtnStyle}"
                                                                Click="BtnMuteDevice_Click"
                                                                Tag="{Binding}"
                                                                Margin="0,0,4,0"
                                                                ToolTip="Toggle Device Mute" />

                                                        <!-- Volume Slider -->
                                                        <Slider Width="95" Height="18"
                                                                Minimum="0" Maximum="100"
                                                                Value="{Binding VolumePercent, Mode=TwoWay}"
                                                                ValueChanged="DeviceVolumeSlider_ValueChanged"
                                                                Tag="{Binding}"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,6,0"
                                                                Cursor="Hand" />

                                                        <!-- Volume Readout -->
                                                        <TextBlock Text="{Binding VolumeText}" FontSize="10.5" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center" MinWidth="30" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Right Group: Actions (Temp Switch, Reorder, Remove, Hide) -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Temp Switch Button -->
                                                <Button Content="⚡ Temp Switch"
                                                        Style="{DynamicResource SmallBtnStyle}"
                                                        Click="BtnTempSwitch_Click"
                                                        Tag="{Binding}"
                                                        IsEnabled="{Binding CanTempSwitch}"
                                                        Margin="0,0,6,0"
                                                        ToolTip="Temporarily switch audio output to this device without changing permanent priority order" />

                                                <!-- Move Up -->
                                                <Button Content="▲" Style="{DynamicResource IconBtnStyle}" Click="BtnMoveUp_Click" Tag="{Binding}" Margin="0,0,4,0" ToolTip="Increase Priority (Move Up)" />

                                                <!-- Move Down -->
                                                <Button Content="▼" Style="{DynamicResource IconBtnStyle}" Click="BtnMoveDown_Click" Tag="{Binding}" Margin="0,0,6,0" ToolTip="Decrease Priority (Move Down)" />

                                                <!-- Remove from priority list -->
                                                <Button Content="✕" Style="{DynamicResource DangerIconBtnStyle}" Click="BtnRemove_Click" Tag="{Binding}" Margin="0,0,4,0" ToolTip="Remove from Priority List" />

                                                <!-- Hide/Ignore device completely -->
                                                <Button Content="🚫" Style="{DynamicResource DangerIconBtnStyle}" Click="BtnHideItem_Click" Tag="{Binding}" ToolTip="Hide &amp; Exclude Device (Never Use)" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Bottom Drop Insertion Guide Line -->
                                        <Border x:Name="BottomDropGuide" Grid.Row="2" Height="3" Background="#3B82F6" CornerRadius="1.5" Margin="0,4,0,0" Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Add Device Bar -->
        <Border Grid.Row="2" Background="#242429" CornerRadius="10" Padding="14,12" Margin="0,12,0,0" BorderBrush="#323238" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="CmbAvailableDevices" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Style="{DynamicResource DarkComboBoxStyle}" Height="34" />

                <Button x:Name="BtnAddDevice" Grid.Column="1" Content="+ Add to Priority List" Style="{DynamicResource PrimaryBtnStyle}" Height="34" Padding="14,0" Margin="0,0,8,0" Click="BtnAddDevice_Click" />

                <Button x:Name="BtnHideDevice" Grid.Column="2" Content="🚫 Hide Device" Style="{DynamicResource SmallBtnStyle}" Height="34" Padding="12,0" ToolTip="Hide selected device completely so it is never used and excluded from lists" Click="BtnHideDevice_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
