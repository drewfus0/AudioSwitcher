<Window x:Class="AudioSwitcher.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AudioSwitcher.UI"
        mc:Ignorable="d"
        Title="AudioSwitcher - Audio Device Priority Manager" 
        Icon="pack://application:,,,/Assets/app.ico"
        Height="620" Width="760" 
        MinHeight="520" MinWidth="660"
        WindowStartupLocation="CenterScreen"
        Background="#121216" Foreground="#F4F4F5"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">



    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content (Tabs) -->
            <RowDefinition Height="*" />
            <!-- Status Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- App Header Bar -->
        <Border Grid.Row="0" Background="#18181F" BorderBrush="#272730" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Margin="0,0,12,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/app.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="AudioSwitcher" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" />
                            <Border Background="#1E3A8A" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.0" FontSize="10" FontWeight="SemiBold" Foreground="#93C5FD" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Automatic priority-based audio switching for Sound &amp; Comms" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Global Auto-Switch Toggle & Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#24242C" CornerRadius="8" Padding="12,6" Margin="0,0,12,0" BorderBrush="#32323D" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Master Auto-Switch" VerticalAlignment="Center" Foreground="#E4E4E7" FontSize="12" FontWeight="Medium" Margin="0,0,8,0" />
                            <CheckBox x:Name="ChkMasterAutoSwitch" IsChecked="True" VerticalAlignment="Center" Checked="ChkMasterAutoSwitch_Changed" Unchecked="ChkMasterAutoSwitch_Changed" Cursor="Hand" />
                        </StackPanel>
                    </Border>

                    <Button Content="Minimize to Tray" Style="{DynamicResource SmallBtnStyle}" Click="BtnMinimizeToTray_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="12,10,12,0">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource ModernTabItemStyle}" />
            </TabControl.Resources>

            <!-- Tab 1: Output - Sound -->
            <TabItem Header="🔊 Output (Sound)">
                <local:PriorityListControl x:Name="CtrlOutputSound" />
            </TabItem>

            <!-- Tab 2: Output - Communications -->
            <TabItem Header="🎧 Output (Comms)">
                <local:PriorityListControl x:Name="CtrlOutputComms" />
            </TabItem>

            <!-- Tab 3: Input - Sound -->
            <TabItem Header="🎤 Input (Sound)">
                <local:PriorityListControl x:Name="CtrlInputSound" />
            </TabItem>

            <!-- Tab 4: Input - Communications -->
            <TabItem Header="🎙️ Input (Comms)">
                <local:PriorityListControl x:Name="CtrlInputComms" />
            </TabItem>

            <!-- Tab 5: Settings -->
            <TabItem Header="⚙️ Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18" MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="Application Preferences" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,14" />

                        <!-- Auto-Switching Options Card -->
                        <Border Background="#1E1E24" CornerRadius="10" Padding="18,14" Margin="0,0,0,14" BorderBrush="#2E2E38" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Automatic Switching Behavior" FontSize="14" FontWeight="SemiBold" Foreground="#60A5FA" Margin="0,0,0,10" />

                                <CheckBox x:Name="ChkOptShowNotifications" Content="Show tray notification balloon when switching devices" Foreground="#E4E4E7" FontSize="13" Margin="0,6" Checked="SettingsOption_Changed" Unchecked="SettingsOption_Changed" Cursor="Hand" />
                            </StackPanel>
                        </Border>

                        <!-- Sound & Communications Synchronization Card -->
                        <Border Background="#1E1E24" CornerRadius="10" Padding="18,14" Margin="0,0,0,14" BorderBrush="#2E2E38" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Sound &amp; Communications Synchronization" FontSize="14" FontWeight="SemiBold" Foreground="#60A5FA" Margin="0,0,0,8" />
                                <TextBlock Text="Choose whether voice communications (Discord, Teams, Zoom) should automatically match and use the same device as system sounds." FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,10" />

                                <CheckBox x:Name="ChkOptMatchOutputComms" Content="Output (Playback): Match Communications to Sound (Always use same output device)" Foreground="#E4E4E7" FontSize="13" Margin="0,6" Checked="SettingsOption_Changed" Unchecked="SettingsOption_Changed" Cursor="Hand" />
                                <CheckBox x:Name="ChkOptMatchInputComms" Content="Input (Microphone): Match Communications to Sound (Always use same microphone)" Foreground="#E4E4E7" FontSize="13" Margin="0,6" Checked="SettingsOption_Changed" Unchecked="SettingsOption_Changed" Cursor="Hand" />
                            </StackPanel>
                        </Border>

                        <!-- System Integration Card -->
                        <Border Background="#1E1E24" CornerRadius="10" Padding="18,14" Margin="0,0,0,14" BorderBrush="#2E2E38" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="System Tray &amp; Startup" FontSize="14" FontWeight="SemiBold" Foreground="#60A5FA" Margin="0,0,0,10" />

                                <CheckBox x:Name="ChkOptStartWithWindows" Content="Start AudioSwitcher automatically with Windows" Foreground="#E4E4E7" FontSize="13" Margin="0,6" Checked="SettingsOption_Changed" Unchecked="SettingsOption_Changed" Cursor="Hand" />
                                <CheckBox x:Name="ChkOptStartMinimized" Content="Start minimized to System Tray" Foreground="#E4E4E7" FontSize="13" Margin="0,6" Checked="SettingsOption_Changed" Unchecked="SettingsOption_Changed" Cursor="Hand" />
                                <CheckBox x:Name="ChkOptCloseToTray" Content="Minimize to System Tray when closing the window (✕)" Foreground="#E4E4E7" FontSize="13" Margin="0,6" Checked="SettingsOption_Changed" Unchecked="SettingsOption_Changed" Cursor="Hand" />
                            </StackPanel>
                        </Border>

                        <!-- Hidden & Ignored Devices Card -->
                        <Border Background="#1E1E24" CornerRadius="10" Padding="18,14" Margin="0,0,0,14" BorderBrush="#2E2E38" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🚫 Hidden &amp; Ignored Devices (Device Filter)" FontSize="14" FontWeight="SemiBold" Foreground="#60A5FA" VerticalAlignment="Center" />
                                    <Button x:Name="BtnUnhideAll" Grid.Column="1" Content="Unhide All" Style="{DynamicResource SmallBtnStyle}" Padding="10,4" Click="BtnUnhideAll_Click" ToolTip="Restore all hidden devices" />
                                </Grid>
                                
                                <TextBlock Text="Devices listed here are excluded from automatic switching, dropdown lists, and system tray menus." FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,12" />

                                <!-- Quick Hide from Settings -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbDevicesToHide" Grid.Column="0" Height="34" Margin="0,0,8,0" Style="{DynamicResource DarkComboBoxStyle}" />
                                    <Button x:Name="BtnHideDeviceInSettings" Grid.Column="1" Content="🚫 Hide Device" Style="{DynamicResource SmallBtnStyle}" Height="34" Padding="12,0" Click="BtnHideDeviceInSettings_Click" />
                                </Grid>

                                <!-- Hidden Devices ItemsControl / List -->
                                <Border Background="#18181F" CornerRadius="8" BorderBrush="#2B2B36" BorderThickness="1" Padding="10" MinHeight="50">
                                    <Grid>
                                        <TextBlock x:Name="TxtNoHiddenDevices" Text="No devices are currently hidden. You can hide devices using the 🚫 button in any priority tab." FontSize="12" Foreground="#52525B" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10" />
                                        <ItemsControl x:Name="ItemsHiddenDevices">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#24242D" CornerRadius="6" Padding="10,8" Margin="0,0,0,6" BorderBrush="#353542" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" Foreground="#F4F4F5" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="✓ Unhide / Restore" Style="{DynamicResource SmallBtnStyle}" Padding="10,4" Click="BtnUnhideDevice_Click" Tag="{Binding}" ToolTip="Restore this device to available lists" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Quick Troubleshooting / Rescan -->
                        <Border Background="#1E1E24" CornerRadius="10" Padding="18,14" BorderBrush="#2E2E38" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Audio Subsystem" FontSize="14" FontWeight="SemiBold" Foreground="#60A5FA" Margin="0,0,0,8" />
                                <TextBlock Text="If a newly connected Bluetooth or USB device isn't showing up, click Rescan to trigger a manual hardware refresh." FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <Button Content="↻ Rescan Audio Devices Now" Style="{DynamicResource PrimaryBtnStyle}" Height="34" Width="220" HorizontalAlignment="Left" Click="BtnRescanDevices_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status Footer -->
        <Border Grid.Row="2" Background="#141419" BorderBrush="#22222A" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="DotStatus" Width="8" Height="8" Fill="#22C55E" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtStatus" Text="Listening for audio device events..." FontSize="11" Foreground="#9CA3AF" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="Right-click tray icon for quick device switching" FontSize="11" Foreground="#6B7280" />
            </Grid>
        </Border>
    </Grid>
</Window>
