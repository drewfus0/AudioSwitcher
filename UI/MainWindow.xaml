<Window x:Class="AudioSwitcher.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AudioSwitcher.UI"
        mc:Ignorable="d"
        Title="AudioSwitcher - Audio Device Priority Manager" 
        Height="620" Width="760" 
        MinHeight="520" MinWidth="660"
        WindowStartupLocation="CenterScreen"
        Background="#121216" Foreground="#F4F4F5"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <!-- Primary Button Style -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#3B82F6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Background" Value="#3F3F46" />
                                <Setter Property="Foreground" Value="#71717A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary/Small Button Style -->
        <Style x:Key="SmallBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#272730" />
            <Setter Property="Foreground" Value="#E4E4E7" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="BorderBrush" Value="#3F3F4E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#383845" />
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#60A5FA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#1E1E24" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon Action Button Style -->
        <Style x:Key="IconBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A35" />
            <Setter Property="Foreground" Value="#D4D4D8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#3F3F50" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#181820" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Icon Button Style -->
        <Style x:Key="DangerIconBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A35" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#7F1D1D" />
                                <Setter Property="Foreground" Value="#F87171" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#991B1B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#1E1E24" />
            <Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="BorderBrush" Value="#3F3F4A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Modern TabControl Style -->
        <Style x:Key="ModernTabItemStyle" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" Padding="14,10" Margin="0,0,4,0" CornerRadius="6">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center"
                                              ContentSource="Header" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#272730" />
                                <Setter Property="Foreground" Value="#60A5FA" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#9CA3AF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#1E1E24" />
                                <Setter Property="Foreground" Value="#E4E4E7" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content (Tabs) -->
            <RowDefinition Height="*" />
            <!-- Status Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- App Header Bar -->
        <Border Grid.Row="0" Background="#18181F" BorderBrush="#272730" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Background="#2563EB" CornerRadius="8" Margin="0,0,12,0">
                        <TextBlock Text="🔊" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="AudioSwitcher" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" />
                            <Border Background="#1E3A8A" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.0" FontSize="10" FontWeight="SemiBold" Foreground="#93C5FD" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Automatic priority-based audio switching for Sound &amp; Comms" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Global Auto-Switch Toggle & Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#24242C" CornerRadius="8" Padding="12,6" Margin="0,0,12,0" BorderBrush="#32323D" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Master Auto-Switch" VerticalAlignment="Center" Foreground="#E4E4E7" FontSize="12" FontWeight="Medium" Margin="0,0,8,0" />
                            <CheckBox x:Name="ChkMasterAutoSwitch" IsChecked="True" VerticalAlignment="Center" Checked="ChkMasterAutoSwitch_Changed" Unchecked="ChkMasterAutoSwitch_Changed" Cursor="Hand" />
                        </StackPanel>
                    </Border>

                    <Button Content="Minimize to Tray" Style="{DynamicResource SmallBtnStyle}" Click="BtnMinimizeToTray_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="12,10,12,0">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource ModernTabItemStyle}" />
            </TabControl.Resources>

            <!-- Tab 1: Output - Sound -->
            <TabItem Header="🔊 Output (Sound)">
                <local:PriorityListControl x:Name="CtrlOutputSound" />
            </TabItem>

            <!-- Tab 2: Output - Communications -->
            <TabItem Header="🎧 Output (Comms)">
                <local:PriorityListControl x:Name="CtrlOutputComms" />
            </TabItem>

            <!-- Tab 3: Input - Sound -->
            <TabItem Header="🎤 Input (Sound)">
                <local:PriorityListControl x:Name="CtrlInputSound" />
            </TabItem>

            <!-- Tab 4: Input - Communications -->
            <TabItem Header="🎙️ Input (Comms)">
                <local:PriorityListControl x:Name="CtrlInputComms" />
            </TabItem>

            <!-- Tab 5: Settings -->
            <TabItem Header="⚙️ Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18" MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="Application Preferences" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,14" />

                        <!-- Auto-Switching Options Card -->
                        <Border Background="#1E1E24" CornerRadius="10" Padding="18,14" Margin="0,0,0,14" BorderBrush="#2E2E38" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Automatic Switching Behavior" FontSize="14" FontWeight="SemiBold" Foreground="#60A5FA" Margin="0,0,0,10" />

                                <CheckBox x:Name="ChkOptShowNotifications" Content="Show tray notification balloon when switching devices" Foreground="#E4E4E7" FontSize="13" Margin="0,6" Checked="SettingsOption_Changed" Unchecked="SettingsOption_Changed" Cursor="Hand" />
                            </StackPanel>
                        </Border>

                        <!-- System Integration Card -->
                        <Border Background="#1E1E24" CornerRadius="10" Padding="18,14" Margin="0,0,0,14" BorderBrush="#2E2E38" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="System Tray &amp; Startup" FontSize="14" FontWeight="SemiBold" Foreground="#60A5FA" Margin="0,0,0,10" />

                                <CheckBox x:Name="ChkOptStartWithWindows" Content="Start AudioSwitcher automatically with Windows" Foreground="#E4E4E7" FontSize="13" Margin="0,6" Checked="SettingsOption_Changed" Unchecked="SettingsOption_Changed" Cursor="Hand" />
                                <CheckBox x:Name="ChkOptStartMinimized" Content="Start minimized to System Tray" Foreground="#E4E4E7" FontSize="13" Margin="0,6" Checked="SettingsOption_Changed" Unchecked="SettingsOption_Changed" Cursor="Hand" />
                                <CheckBox x:Name="ChkOptCloseToTray" Content="Minimize to System Tray when closing the window (✕)" Foreground="#E4E4E7" FontSize="13" Margin="0,6" Checked="SettingsOption_Changed" Unchecked="SettingsOption_Changed" Cursor="Hand" />
                            </StackPanel>
                        </Border>

                        <!-- Quick Troubleshooting / Rescan -->
                        <Border Background="#1E1E24" CornerRadius="10" Padding="18,14" BorderBrush="#2E2E38" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Audio Subsystem" FontSize="14" FontWeight="SemiBold" Foreground="#60A5FA" Margin="0,0,0,8" />
                                <TextBlock Text="If a newly connected Bluetooth or USB device isn't showing up, click Rescan to trigger a manual hardware refresh." FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <Button Content="↻ Rescan Audio Devices Now" Style="{DynamicResource PrimaryBtnStyle}" Height="34" Width="220" HorizontalAlignment="Left" Click="BtnRescanDevices_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status Footer -->
        <Border Grid.Row="2" Background="#141419" BorderBrush="#22222A" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="DotStatus" Width="8" Height="8" Fill="#22C55E" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtStatus" Text="Listening for audio device events..." FontSize="11" Foreground="#9CA3AF" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="Right-click tray icon for quick device switching" FontSize="11" Foreground="#6B7280" />
            </Grid>
        </Border>
    </Grid>
</Window>
