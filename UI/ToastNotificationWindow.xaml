<Window x:Class="AudioSwitcher.UI.ToastNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioSwitcher Notification"
        Width="350" Height="82"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Cursor="Hand"
        MouseLeftButtonUp="Toast_MouseLeftButtonUp">
    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.25" />
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.0" Duration="0:0:0.35" />
        </Storyboard>
    </Window.Resources>
    
    <Border x:Name="ToastBorder" Background="#1A1A23" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="9" Margin="6" Padding="12,10">
        <Border.RenderTransform>
            <TranslateTransform />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.65" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Category / Action Icon -->
            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#242432" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock x:Name="TxtIcon" Text="🔊" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Message details -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtTitle" Text="AudioSwitcher • Auto-Switched" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" />
                    <Border x:Name="BdrVolumeBadge" Background="#1E3A8A" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtVolumeBadge" Text="45%" FontSize="9.5" FontWeight="Bold" Foreground="#93C5FD" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="TxtMessage" Text="Switched to Speakers (Realtek Audio)" FontSize="12.5" FontWeight="SemiBold" Foreground="#F4F4F5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Dismiss Button -->
            <Button Grid.Column="2" Content="✕" Width="20" Height="20" FontSize="10" Style="{DynamicResource DangerIconBtnStyle}" VerticalAlignment="Top" Click="BtnDismiss_Click" ToolTip="Dismiss" />
        </Grid>
    </Border>
</Window>
